{
  "info": {
    "name": "Mutari API",
    "_postman_id": "mutari-engine",
    "description": "Mutari Compatibility Engine API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "jwt_token",
      "value": ""
    },
    {
      "key": "user_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        }
      }
    },

    {
      "name": "Signup",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n\"name\":\"Test User\",\n\"email\":\"test@mutari.ai\",\n\"password\":\"123456\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/signup",
          "host": ["{{base_url}}"],
          "path": ["signup"]
        }
      }
    },

    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let json = pm.response.json();",
              "pm.environment.set(\"jwt_token\", json.token);",
              "pm.environment.set(\"user_id\", json.user_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n\"email\":\"test@mutari.ai\",\n\"password\":\"123456\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": ["{{base_url}}"],
          "path": ["login"]
        }
      }
    },

    {
      "name": "Get MCP Questions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/mcp/questions",
          "host": ["{{base_url}}"],
          "path": ["mcp","questions"]
        }
      }
    },

    {
      "name": "Submit MCP Answers",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n\"user_id\": {{user_id}},\n\"answers\": [\n{\n\"question_id\":1,\n\"block\":0,\n\"value\":0.9\n},\n{\n\"question_id\":2,\n\"block\":0,\n\"value\":0.8\n}\n]\n}"
        },
        "url": {
          "raw": "{{base_url}}/mcp/answers",
          "host": ["{{base_url}}"],
          "path": ["mcp","answers"]
        }
      }
    },

    {
      "name": "Get Matches",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/matches/{{user_id}}",
          "host": ["{{base_url}}"],
          "path": ["matches","{{user_id}}"]
        }
      }
    },

    {
      "name": "Rebuild Profiles",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/admin/rebuild",
          "host": ["{{base_url}}"],
          "path": ["admin","rebuild"]
        }
      }
    }
  ]
}