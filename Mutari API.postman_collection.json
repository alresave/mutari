{
  "info": {
    "name": "Mutari — Supabase API",
    "description": "Colección vigente para Supabase Auth y las funciones Edge de Mutari.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "supabase_url", "value": "https://wbfuymqkcximyiihatrk.supabase.co" },
    { "key": "functions_url", "value": "{{supabase_url}}/functions/v1" },
    { "key": "anon_key", "value": "sb_publishable_sTB2-o1iShGfOQmoSl0Ziw_siVDMlCE" },
    { "key": "email", "value": "" },
    { "key": "password", "value": "" },
    { "key": "name", "value": "" },
    { "key": "access_token", "value": "" },
    { "key": "team_id", "value": "1" },
    { "key": "user_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "apikey", "value": "{{anon_key}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"data\": { \"name\": \"{{name}}\" }\n}" },
            "url": "{{supabase_url}}/auth/v1/signup"
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "if (body.access_token) pm.collectionVariables.set('access_token', body.access_token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "apikey", "value": "{{anon_key}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{supabase_url}}/auth/v1/token?grant_type=password"
          }
        }
      ]
    },
    {
      "name": "MCP",
      "item": [
        { "name": "Get MCP Questions", "request": { "method": "GET", "header": [{ "key": "apikey", "value": "{{anon_key}}" }], "url": "{{functions_url}}/mcp/questions" } },
        { "name": "Submit MCP Answers", "request": { "method": "POST", "header": [{ "key": "apikey", "value": "{{anon_key}}" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"answers\": [\n    { \"question_id\": 1, \"value\": 0.9 },\n    { \"question_id\": 2, \"value\": 0.8 }\n  ]\n}" }, "url": "{{functions_url}}/mcp/answers" } },
        { "name": "Get Matches", "request": { "method": "GET", "header": [{ "key": "apikey", "value": "{{anon_key}}" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": "{{functions_url}}/mcp/matches" } }
      ]
    },
    {
      "name": "Teams",
      "item": [
        { "name": "Get Teams", "request": { "method": "GET", "header": [{ "key": "apikey", "value": "{{anon_key}}" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": "{{functions_url}}/teams/" } },
        { "name": "Team Matches", "request": { "method": "GET", "header": [{ "key": "apikey", "value": "{{anon_key}}" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": "{{functions_url}}/teams/{{team_id}}/matches" } },
        { "name": "Team User Fit", "request": { "method": "GET", "header": [{ "key": "apikey", "value": "{{anon_key}}" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": "{{functions_url}}/teams/{{team_id}}/fit/{{user_id}}" } },
        { "name": "Team Culture", "request": { "method": "GET", "header": [{ "key": "apikey", "value": "{{anon_key}}" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": "{{functions_url}}/teams/{{team_id}}/culture" } },
        { "name": "Team Gaps", "request": { "method": "GET", "header": [{ "key": "apikey", "value": "{{anon_key}}" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": "{{functions_url}}/teams/{{team_id}}/gaps" } },
        { "name": "Hiring Profile", "request": { "method": "GET", "header": [{ "key": "apikey", "value": "{{anon_key}}" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": "{{functions_url}}/teams/{{team_id}}/hiring-profile" } }
      ]
    },
    {
      "name": "Administration (admin only)",
      "item": [
        { "name": "Create Company", "request": { "method": "POST", "header": [{ "key": "apikey", "value": "{{anon_key}}" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"action\": \"create_company\", \"name\": \"Example Inc.\", \"website\": \"https://example.com\" }" }, "url": "{{functions_url}}/admin" } },
        { "name": "Create Team", "request": { "method": "POST", "header": [{ "key": "apikey", "value": "{{anon_key}}" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"action\": \"create_team\", \"name\": \"Product\", \"description\": \"Product team\" }" }, "url": "{{functions_url}}/admin" } },
        { "name": "Add Team Member", "request": { "method": "POST", "header": [{ "key": "apikey", "value": "{{anon_key}}" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"action\": \"add_member\", \"team_id\": {{team_id}}, \"user_id\": \"{{user_id}}\", \"role\": \"member\" }" }, "url": "{{functions_url}}/admin" } }
      ]
    }
  ]
}
